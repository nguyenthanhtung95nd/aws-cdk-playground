{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: local API (debug)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/lambdas",
      "program": "${workspaceFolder}/lambdas/node_modules/tsx/dist/cli.mjs",
      "args": ["local/server.ts"],
      "console": "integratedTerminal",
      "preLaunchTask": "aws:up",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Backend: worker (debug)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/lambdas",
      "program": "${workspaceFolder}/lambdas/node_modules/tsx/dist/cli.mjs",
      "args": ["local/worker.ts"],
      "console": "integratedTerminal",
      "preLaunchTask": "aws:up",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Frontend: mock (debug)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "fe:dev:mock"
    },
    {
      "name": "Frontend: local backend (debug)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "fe:dev:local"
    },
    {
      "name": "Tests: infra (debug)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Tests: lambdas (debug)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/lambdas",
      "program": "${workspaceFolder}/lambdas/node_modules/vitest/vitest.mjs",
      "args": ["run"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Tests: frontend (debug)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "program": "${workspaceFolder}/frontend/node_modules/vitest/vitest.mjs",
      "args": ["run"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Full-stack local (debug)",
      "configurations": ["Backend: local API (debug)", "Frontend: local backend (debug)"],
      "stopAll": true
    },
    {
      "name": "Full-stack local + worker (debug)",
      "configurations": [
        "Backend: local API (debug)",
        "Backend: worker (debug)",
        "Frontend: local backend (debug)"
      ],
      "stopAll": true
    }
  ]
}
