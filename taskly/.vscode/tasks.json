{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "db:up",
      "type": "shell",
      "command": "docker compose up -d",
      "options": { "cwd": "${workspaceFolder}/lambdas" },
      "problemMatcher": []
    },
    {
      "label": "db:down",
      "type": "shell",
      "command": "docker compose down",
      "options": { "cwd": "${workspaceFolder}/lambdas" },
      "problemMatcher": []
    },
    {
      "label": "fe:dev:mock",
      "type": "npm",
      "script": "dev:mock",
      "path": "frontend/",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      }
    },
    {
      "label": "fe:dev:local",
      "type": "npm",
      "script": "dev:local",
      "path": "frontend/",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      }
    }
  ]
}
